# =============================================================================
# backup.conf - Configuration for backup.sh
# =============================================================================
# Copy this file to backup.conf and modify values below.
# backup.conf is ignored by Git - never commit it!
# =============================================================================

# -----------------------------------------------------------------------------
# PATHS - Required
# -----------------------------------------------------------------------------
BACKUP_BASE_DIR="/path/to/backup"
SOURCE_DIR="/path/to/source/data"

# -----------------------------------------------------------------------------
# DOCKER VOLUMES - Required
# -----------------------------------------------------------------------------
DOCKER_VOLUMES=(
    "volume-1"
    "volume-2"
)

# -----------------------------------------------------------------------------
# NOTIFICATION - Required (get from https://ntfy.sh)
# -----------------------------------------------------------------------------
NTFY_TOPIC="your-backup-topic"
NTFY_TOKEN="your-ntfy-token"

# Optional: Use a custom ntfy server
# NTFY_CUSTOM_SERVER="https://notify.yourdomain.com"

# -----------------------------------------------------------------------------
# ENCRYPTION - Required
# -----------------------------------------------------------------------------
ENCRYPTION_KEY_FILE="/path/to/encryption.key"
# Generate: openssl rand -base64 32 > encryption.key && chmod 600 encryption.key

# PBKDF2 iterations for key derivation (higher = more secure but slower)
# Recommended: 600000+ for 2024 security standards
# Default: 600000
# PBKDF2_ITERATIONS=600000

# -----------------------------------------------------------------------------
# DEDUPLICATION - Optional
# -----------------------------------------------------------------------------
# To enable deduplication, set a fixed salt file and choose a dedup tool.
# Fixed salt makes encryption deterministic: identical source data produces
# identical encrypted files, so hard links can replace duplicates.
#
# Generate fixed salt (16 hex chars = 8 bytes):
#   openssl rand -hex 8 > fixed_salt.txt
#   chmod 600 fixed_salt.txt
#
# FIXED_SALT_FILE="/path/to/fixed_salt.txt"

# Deduplication tool: "hardlink" (default) or "jdupes"
# Leave empty to skip dedup entirely.
# DEDUP_TOOL="hardlink"

# -----------------------------------------------------------------------------
# RETENTION
# -----------------------------------------------------------------------------
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=6

# -----------------------------------------------------------------------------
# COMPRESSION
# -----------------------------------------------------------------------------
GZIP_LEVEL=6  # 1=fast, 9=small

# -----------------------------------------------------------------------------
# DOCKER
# -----------------------------------------------------------------------------
DOCKER_IMAGE="alpine:latest"

# -----------------------------------------------------------------------------
# ADVANCED
# -----------------------------------------------------------------------------
VERBOSE=false                          # Enable debug logging
BACKUP_PREFIX="backup"                 # Backup folder prefix
EXCLUDE_PATTERNS="*.tmp *.log cache/"  # Files to exclude
MAX_BACKUP_SIZE_MB=0                   # 0 = unlimited